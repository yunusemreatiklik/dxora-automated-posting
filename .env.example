# Safety switch: leave false until you configured five channels you own/administer.
POSTING_ENABLED=false

# Mastodon: access token with write:statuses scope; user-owned instance/account.
MASTODON_BASE_URL=https://mastodon.social
MASTODON_TOKEN=

# Bluesky: handle and app password (NOT the main account password).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Telegram: bot must be an admin of this public channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_CHANNEL=@yourpublicchannel

# Discord: webhook created by you for a channel you administer.
# Discord posts are NOT necessarily publicly accessible outside that server.
DISCORD_WEBHOOK_URL=

# WordPress.com free plan: OAuth2 app from https://developer.wordpress.com/apps/
# Launch local server, then browse http://localhost:4000/wordpress/connect
# Code stores the OAuth access token in .wordpress_oauth_token.json (gitignored).
WORDPRESS_BASE_URL=https://yourblog.wordpress.com
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
# For separately hosted WordPress only (WordPress.com does NOT use these):
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
